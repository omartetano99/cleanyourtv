<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/home_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <RelativeLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="100dp"
            android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="22dp" android:paddingBottom="16dp">
            <LinearLayout android:id="@+id/identity" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_centerVertical="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
                    android:textSize="32sp" android:textColor="@color/home_text" android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600" android:includeFontPadding="false" />
                <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="@color/home_muted" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 450" />
            </LinearLayout>
            <LinearLayout android:id="@+id/topButtons" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_toEndOf="@id/identity" android:layout_toStartOf="@+id/headerClock" android:layout_centerVertical="true" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/btnInputs" style="@style/TopButton" android:text="@string/inputs" android:drawableStart="@drawable/ic_input" />
                <TextView android:id="@+id/btnWifi" style="@style/TopButton" android:text="@string/wifi" android:drawableStart="@drawable/ic_wifi"
                    android:maxWidth="120dp" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/btnAllApps" style="@style/TopButton" android:text="@string/all_apps" />
                <TextView android:id="@+id/btnRows" style="@style/TopButton" android:text="@string/rows_manager" android:drawableStart="@drawable/rows_ic" />
                <TextView android:id="@+id/btnSettings" style="@style/TopButton" android:text="@string/settings" android:drawableStart="@drawable/ic_settings" />
            </LinearLayout>
            <LinearLayout android:id="@+id/headerClock" android:layout_width="112dp" android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="end" android:layout_alignParentEnd="true" android:layout_centerVertical="true">
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textColor="@color/home_text"
                    android:textSize="22sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 450" android:includeFontPadding="false" />
                <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textColor="@color/home_muted"
                    android:textSize="14sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 450" />
            </LinearLayout>
        </RelativeLayout>
        <com.gathin.tvhome.HomeScrollView android:id="@+id/videoRowsWrap"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:overScrollMode="never" android:scrollbars="none" android:clipToPadding="true" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingBottom="48dp">
                <LinearLayout android:id="@+id/cinemanaShelf" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" />
                <TextView android:id="@+id/appsCaption" style="@style/ShelfTitle" android:text="@string/your_apps" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
                    android:layout_height="158dp" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="10dp" android:paddingBottom="12dp" android:clipToPadding="false"
                    android:clipChildren="false" android:overScrollMode="never" android:scrollbars="none"
                    android:descendantFocusability="afterDescendants" />
                <TextView android:id="@+id/contentStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="8dp" android:text="@string/loading_rows" android:textColor="@color/home_muted"
                    android:textSize="15sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 450" />
                <LinearLayout android:id="@+id/videoRows" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" />
                <include layout="@layout/channel_row" />
            </LinearLayout>
        </com.gathin.tvhome.HomeScrollView>
    </LinearLayout>
</FrameLayout>
