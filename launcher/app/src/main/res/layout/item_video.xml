<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="236dp" android:layout_height="wrap_content" android:orientation="vertical"
    android:clipChildren="false" android:clipToPadding="false">
    <FrameLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="133dp"
        android:background="@drawable/tile_bg" android:foreground="@drawable/focus_outline" android:focusable="true" android:clickable="true">
        <TextView android:id="@+id/artFallback" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="18dp" android:maxLines="3" android:ellipsize="end"
            android:textSize="16sp" android:textColor="@color/home_muted" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 450" />
        <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:contentDescription="@null" />
        <ProgressBar android:id="@+id/watchProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_gravity="bottom"
            android:progressTint="@color/home_accent" android:progressBackgroundTint="#66000000" android:max="1000" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:textDirection="firstStrong"
        android:textColor="@color/home_text" android:textSize="15sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 450" android:includeFontPadding="false" />
    <LinearLayout android:id="@+id/bannerDetails" android:layout_width="match_parent" android:layout_height="26dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/bannerRating" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/home_text" android:fontFamily="@font/outfit"
            android:textDirection="ltr" android:includeFontPadding="false" />
        <TextView android:id="@+id/bannerGenres" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="14dp" android:textSize="13sp" android:textColor="@color/home_muted"
            android:fontFamily="@font/outfit" android:textDirection="firstStrong" android:gravity="end"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>